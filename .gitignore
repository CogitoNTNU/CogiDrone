# * Toolchain
# ! NOTE: THIS FILE IS REQUIRED TO BE GIT-IGNORED, ELSE IT WILL CAUSE OVERWRITES OF THE TOOLCHAIN CONFIGURATION FOR EVERYONE ELSE USING WINDOWS !!!!
toolchain.windows.config


# * 3rd party libraries
# ? vendored/ is committed on purpose - it is the IntelliSense and cross-link source.
# ! The negation below is LOAD-BEARING. The generic rules above (*.so, lib/, lib64/,
# ! __pycache__/, *.py[cod]) match files INSIDE vendored/. Without !vendored/**,
# ! a fresh clone gets headers but no .so files, and the link fails with
# ! "cannot find -lpx4_msgs__rosidl_typesupport_cpp".
# ! Order matters: this must come after the generic rules, and the debs rule
# ! must come after this one.
!vendored/**
vendored/ros2/debs/


# * Generated
# ? TensorRT plans are device- and version-specific - never commit them
models/*.engine

# ? Generated by sim/tools/bymarka/make_world.py, make_dense.py and sim/tools/people (multi-GB, re-run the scripts)
sim/models/bymarka_*/
sim/models/person_*/
