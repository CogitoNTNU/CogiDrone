<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cogidrone_bringup</name>
  <version>0.0.1</version>
  <description>Launch files and config that start the CogiDrone simulation and autonomy stack.</description>
  <maintainer email="cogidrone@example.com">CogiDrone team</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>cogidrone_perception</exec_depend>
  <exec_depend>cogidrone_control</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
